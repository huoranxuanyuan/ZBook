# Preserve exact release input bytes across checkout and staging.
# Text files retain their existing LF/CRLF; binaries never use text filters.
* -text
*.exe binary
*.pdf binary
*.doc binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.webp binary
# Upstream license text keeps its original whitespace and line endings.
licenses/*.txt -whitespace
# The original PyInstaller RST uses a seven-character underline for its heading.
licenses/pyinstaller.txt conflict-marker-size=32
